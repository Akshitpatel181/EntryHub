@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Welcome";
}

<style>
    /* ENTRYHUB — PROFESSIONAL HOMEPAGE */

    .eh-page,
    .eh-page * {
        box-sizing: border-box;
    }

    .eh-page {
        --eh-ink: #f4f9fb;
        --eh-muted: #a7c0cb;
        --eh-teal: #13b5a9;
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 0 clamp(20px, 4vw, 76px);
        overflow: hidden;
        color: var(--eh-ink);
        background: radial-gradient( ellipse at 92% 33%, rgba(19,181,169,.13), transparent 43% ), linear-gradient( 130deg, #071924, #0b2733 65%, #09212e );
    }

    .eh-shell {
        max-width: 1280px;
        margin: 0 auto;
    }

    /* TOP BAR */

    .eh-topbar {
        height: 104px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(188,225,233,.12);
    }

    .eh-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #fff;
        font-size: 25px;
        font-weight: 750;
        letter-spacing: -.035em;
    }

    .eh-brand-icon {
        width: 43px;
        height: 43px;
        border-radius: 11px;
        background: #087f7d;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

        .eh-brand-icon svg {
            height: 25px;
            width: 25px;
            fill: currentColor;
        }

    .eh-topnote {
        color: #b0c8cf;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: .08em;
    }

    /* MAIN CONTENT */

    .eh-main {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
        align-items: center;
        gap: clamp(40px, 5vw, 90px);
        padding: clamp(78px, 10vh, 126px) 0 80px;
    }

    .eh-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 26px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .18em;
        font-weight: 700;
        color: #63dacf;
    }

        .eh-eyebrow::before {
            content: "";
            width: 22px;
            height: 2px;
            background: #35c8ba;
        }

    .eh-heading {
        max-width: 700px;
        margin: 0 0 28px;
        color: #fff;
        font-size: clamp(44px, 5.05vw, 76px);
        font-weight: 800;
        letter-spacing: -.055em;
        line-height: 1.085;
    }

        .eh-heading em {
            font-style: normal;
            color: #5bd5cb;
        }

    .eh-description {
        max-width: 560px;
        margin: 0 0 40px;
        color: var(--eh-muted);
        font-size: clamp(16px, 1.35vw, 19px);
        line-height: 1.72;
    }

    /* SIGN-IN BUTTON */

    .eh-signin {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 26px;
        min-width: min(100%, 332px);
        padding: 17px 21px 17px 26px;
        border-radius: 11px;
        background: #13a89e;
        color: #fff !important;
        text-decoration: none !important;
        font-weight: 750;
        font-size: 16px;
        box-shadow: 0 16px 34px rgba(0,0,0,.15);
        transition: background .2s ease, transform .2s ease;
    }

        .eh-signin:hover,
        .eh-signin:focus-visible {
            background: #0d8e86;
            transform: translateY(-2px);
        }

        .eh-signin:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 4px;
        }

        .eh-signin svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
        }

    .eh-signin-note {
        margin: 15px 0 0;
        font-size: 13px;
        color: #8daeb9;
    }

    /* VISITOR WORKFLOW PREVIEW */

    .eh-visual {
        border: 1px solid rgba(161,222,222,.19);
        padding: 20px;
        border-radius: 22px;
        background: linear-gradient( 150deg, rgba(36,76,89,.65), rgba(9,31,43,.8) );
        box-shadow: 0 30px 90px rgba(0,0,0,.2);
    }

    .eh-window {
        overflow: hidden;
        background: #f7fafb;
        color: #1a3440;
        border-radius: 14px;
        box-shadow: 0 18px 60px rgba(0,0,0,.17);
    }

    .eh-window-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 20px;
        border-bottom: 1px solid #e3ecee;
    }

        .eh-window-head strong {
            font-size: 15px;
            color: #13343b;
        }

    .eh-window-dots {
        display: flex;
        gap: 5px;
    }

        .eh-window-dots i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #c4d8dd;
        }

    .eh-window-body {
        padding: 32px 27px;
    }

    .eh-mini-overline {
        color: #64828c;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 750;
        letter-spacing: .13em;
        margin-bottom: 9px;
    }

    .eh-window-title {
        font-size: 25px;
        letter-spacing: -.04em;
        font-weight: 750;
        margin: 0 0 7px;
    }

    .eh-window-subtitle {
        font-size: 13px;
        color: #708891;
        margin: 0 0 26px;
    }

    /* WORKFLOW STEPS */

    .eh-steps {
        display: grid;
        gap: 13px;
    }

    .eh-step {
        display: flex;
        gap: 13px;
        align-items: center;
        border: 1px solid #e4edef;
        border-radius: 10px;
        padding: 14px 15px;
        background: #fff;
    }

    .eh-step-num {
        display: grid;
        place-items: center;
        width: 33px;
        height: 33px;
        flex: 0 0 33px;
        border-radius: 8px;
        background: #e0f6f2;
        color: #057c73;
        font-size: 13px;
        font-weight: 800;
    }

    .eh-step strong {
        display: block;
        color: #173943;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .eh-step span {
        color: #69838d;
        font-size: 12px;
    }

    .eh-window-foot {
        padding: 15px 20px;
        border-top: 1px solid #e3ecee;
        font-size: 12px;
        color: #68818b;
        background: #f1f7f7;
    }

        .eh-window-foot b {
            color: #087f77;
        }

    /* BENEFITS */

    .eh-benefits {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 30px;
        padding: 30px 0 34px;
        border-top: 1px solid rgba(188,225,233,.14);
    }

    .eh-benefit {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .eh-benefit-icon {
        width: 41px;
        height: 41px;
        flex: 0 0 41px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(69,206,195,.3);
        border-radius: 10px;
        color: #60ddd0;
    }

        .eh-benefit-icon svg {
            width: 21px;
            height: 21px;
            stroke: currentColor;
            stroke-width: 1.8;
            fill: none;
        }

    .eh-benefit strong {
        color: #f6fbfc;
        display: block;
        font-size: 14px;
        margin: 1px 0 6px;
    }

    .eh-benefit span {
        color: #9cb8c2;
        display: block;
        line-height: 1.6;
        font-size: 12px;
    }

    /* FOOTER */

    .eh-bottom {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 21px 0 29px;
        border-top: 1px solid rgba(188,225,233,.10);
        font-size: 12px;
        color: #86a2ad;
    }

    /* TABLET */

    @@media (max-width: 900px) {
        .eh-main {
            grid-template-columns: 1fr;
            gap: 50px;
            padding: 75px 0 60px;
        }

        .eh-visual {
            max-width: 600px;
            width: 100%;
            margin: 0 auto;
        }

        .eh-heading {
            max-width: 730px;
        }
    }

    /* MOBILE */

    @@media (max-width: 620px) {
        .eh-page {
            padding: 0 19px;
        }

        .eh-topbar {
            height: 80px;
        }

        .eh-topnote {
            display: none;
        }

        .eh-main {
            padding: 55px 0 44px;
            gap: 42px;
        }

        .eh-heading {
            font-size: clamp(39px, 9vw, 56px);
        }

        .eh-description {
            font-size: 16px;
        }

        .eh-signin {
            width: 100%;
        }

        .eh-visual {
            padding: 10px;
        }

        .eh-window-body {
            padding: 24px 17px;
        }

        .eh-benefits {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .eh-bottom {
            flex-direction: column;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .eh-signin {
            transition: none;
        }

            .eh-signin:hover {
                transform: none;
            }
    }
</style>

<main class="eh-page">
    <div class="eh-shell">

        <!-- HEADER -->
        <header class="eh-topbar">

            <div class="eh-brand">
                <span class="eh-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="7.5" r="4" />
                        <path d="M4 21c0-4.5 3.2-7.5 8-7.5s8 3 8 7.5z" />
                    </svg>
                </span>

                EntryHub
            </div>

            <div class="eh-topnote">
                VISITOR MANAGEMENT PLATFORM
            </div>

        </header>

        <!-- MAIN HERO -->
        <section class="eh-main" aria-labelledby="eh-title">

            <div>
                <p class="eh-eyebrow">
                    A better way to welcome
                </p>

                <h1 class="eh-heading" id="eh-title">
                    Your front desk,<br />
                    <em>reimagined.</em>
                </h1>

                <p class="eh-description">
                    Welcome visitors, manage check-ins and check-outs,
                    and notify the right people — all through one
                    streamlined platform.
                </p>

                <a class="eh-signin"
                   asp-controller="Account"
                   asp-action="Login">

                    <span>Sign in to EntryHub</span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14m-6-6 6 6-6 6"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </a>

                <p class="eh-signin-note">
                    For authorised administrators and hosts
                </p>
            </div>

            <!-- VISITOR WORKFLOW PREVIEW -->
            <div class="eh-visual"
                 aria-label="Illustration of the visitor check-in workflow">

                <div class="eh-window">

                    <div class="eh-window-head">
                        <strong>Visitor check-in</strong>

                        <span class="eh-window-dots" aria-hidden="true">
                            <i></i><i></i><i></i>
                        </span>
                    </div>

                    <div class="eh-window-body">

                        <div class="eh-mini-overline">
                            A simple arrival experience
                        </div>

                        <h2 class="eh-window-title">
                            From arrival to notification
                        </h2>

                        <p class="eh-window-subtitle">
                            A clear process for every visitor and host.
                        </p>

                        <div class="eh-steps">

                            <div class="eh-step">
                                <span class="eh-step-num">01</span>

                                <div>
                                    <strong>Visitor checks in</strong>
                                    <span>
                                        Details are captured at a paired kiosk
                                    </span>
                                </div>
                            </div>

                            <div class="eh-step">
                                <span class="eh-step-num">02</span>

                                <div>
                                    <strong>Host is notified</strong>
                                    <span>
                                        The selected host receives an arrival alert
                                    </span>
                                </div>
                            </div>

                            <div class="eh-step">
                                <span class="eh-step-num">03</span>

                                <div>
                                    <strong>Visit is recorded</strong>
                                    <span>
                                        Check-in and check-out history stays organised
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="eh-window-foot">
                        <b>EntryHub</b> · One connected visitor experience
                    </div>

                </div>
            </div>

        </section>

        <!-- KEY BENEFITS -->
        <section class="eh-benefits" aria-label="EntryHub benefits">

            <div class="eh-benefit">
                <span class="eh-benefit-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2 4 5v6c0 5 3.2 8.3 8 11 4.8-2.7 8-6 8-11V5l-8-3Z" />
                        <path d="m8 12 3 3 5-6" />
                    </svg>
                </span>

                <div>
                    <strong>Controlled access</strong>
                    <span>
                        Separate roles for administrators, hosts
                        and paired kiosks.
                    </span>
                </div>
            </div>

            <div class="eh-benefit">
                <span class="eh-benefit-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M8 2v4M16 2v4M3 10h18M8 14h3" />
                    </svg>
                </span>

                <div>
                    <strong>Organised visits</strong>
                    <span>
                        Track arrivals, departures and visitor information.
                    </span>
                </div>
            </div>

            <div class="eh-benefit">
                <span class="eh-benefit-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" />
                    </svg>
                </span>

                <div>
                    <strong>Host notifications</strong>
                    <span>
                        Keep the right person informed
                        when a visitor arrives.
                    </span>
                </div>
            </div>

        </section>

        <!-- FOOTER -->
        <footer class="eh-bottom">
            <span>
                © @DateTime.Now.Year EntryHub. All rights reserved.
            </span>

            <span>
                Visitor management, made simpler.
            </span>
        </footer>

    </div>
</main>
