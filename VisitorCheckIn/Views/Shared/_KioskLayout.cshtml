<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>@ViewData["Title"]</title>
  <link rel="manifest" href="/kiosk.webmanifest" />
  <meta name="theme-color" content="#10252e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="EntryHub" />
  <link rel="icon" type="image/png" href="~/icons/icon-192.png" />
  <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
  <link href="~/css/kiosk.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="kiosk">
  @RenderBody()
  @Html.AntiForgeryToken()
  <button id="fs" class="fs-btn" title="Full screen" aria-label="Full screen">⛶</button>
  <script src="~/js/common.js" asp-append-version="true"></script>
  <script>
    document.getElementById('fs').addEventListener('click', function () {
      if (document.fullscreenElement) document.exitFullscreen();
      else (document.documentElement.requestFullscreen || document.documentElement.webkitRequestFullscreen || function(){}).call(document.documentElement);
    });
    var wl = null;
    async function lockScreen() { try { wl = await navigator.wakeLock.request('screen'); } catch (e) {} }
    lockScreen();
    document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') lockScreen(); });
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
