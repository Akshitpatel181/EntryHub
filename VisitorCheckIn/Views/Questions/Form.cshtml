@model Question
@{ ViewData["Title"] = Model.Id == 0 ? "Add question" : "Edit question"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Questions appear on the kiosk after the visitor enters their name.</p></div></div>
<form method="post" class="card form-card"><div class="card-body">
  <div asp-validation-summary="All" class="text-danger"></div>
  <div class="mb-3"><label asp-for="Text" class="form-label">Question text</label><input asp-for="Text" class="form-control" placeholder="e.g. Do you have a company laptop with you?" /></div>
  <div class="mb-3"><label asp-for="Type" class="form-label">Answer type</label>
    <select asp-for="Type" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select" id="type"></select></div>
  <div class="mb-3" id="optsBox"><label asp-for="OptionsText" class="form-label">Options <span class="text-muted fw-normal">(one per line)</span></label><textarea asp-for="OptionsText" class="form-control" rows="5"></textarea></div>
  <div class="mb-3"><label asp-for="VisitorType" class="form-label">Show to</label>
    <select asp-for="VisitorType" class="form-select">
      <option value="All">All visitor types</option>
      @foreach (var t in VisitorTypes.All) { <option value="@t">@t only</option> }
    </select></div>
  <div class="form-check mb-2"><input asp-for="IsRequired" class="form-check-input" /><label asp-for="IsRequired" class="form-check-label">Required</label></div>
  <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active (shown on kiosk)</label></div>
  <div class="form-actions"><button class="btn btn-primary">Save question</button><a class="btn btn-link" asp-action="Index">Cancel</a></div>
</div></form>
@section Scripts {
  <script>
    var t = document.getElementById('type'), box = document.getElementById('optsBox');
    function sync() { box.style.display = (t.value === 'Dropdown' || t.value === 'Checkbox') ? '' : 'none'; }
    t.addEventListener('change', sync); sync();
  </script>
}
