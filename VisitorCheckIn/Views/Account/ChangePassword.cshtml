@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-5" style="max-width: 550px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Change Password</h4>
        </div>

        <div class="card-body p-4">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="currentPassword" class="form-label">
                        Current Password
                    </label>
                    <input type="password"
                           id="currentPassword"
                           name="currentPassword"
                           class="form-control"
                           autocomplete="current-password"
                           required />
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label">
                        New Password
                    </label>
                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           class="form-control"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">
                        Confirm New Password
                    </label>
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           required />
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Update Password
                </button>
            </form>

        </div>
    </div>
</div>

                    
@if (User.IsInRole("Admin"))
{
    <div class="container mt-4" style="max-width: 550px;">
        <div class="alert alert-warning">
            <strong>Administrator Email Update</strong>
            <p>Change the administrator login email to admin@entryhub.com.</p>

            <form asp-controller="Account"
                  asp-action="UpdateAdminEmail"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-warning">
                    Update Administrator Email
                </button>
            </form>
        </div>
    </div>
}
