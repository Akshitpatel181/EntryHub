@{
    ViewData["Title"] = "Change Password";
}

<style>
    /* ENTRYHUB - CHANGE PASSWORD */

    .eh-password-page {
        max-width: 650px;
        margin: 0 auto;
        padding: 20px 0 50px;
    }

    .eh-password-heading {
        margin-bottom: 25px;
    }

        .eh-password-heading h1 {
            color: #f1f8fb;
            font-size: 28px;
            font-weight: 750;
            margin-bottom: 8px;
        }

        .eh-password-heading p {
            color: #a1bdc9;
            font-size: 14px;
            margin: 0;
        }

    .eh-password-card {
        background: #102b3a;
        border: 1px solid #294857;
        border-radius: 15px;
        overflow: hidden;
    }

    .eh-password-content {
        padding: 30px;
    }

    .eh-password-label {
        display: block;
        color: #e1edf2;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 9px;
    }

    .eh-password-field {
        margin-bottom: 23px;
    }

    .eh-password-input-group {
        display: flex;
        align-items: stretch;
        position: relative;
    }

    .eh-password-input {
        width: 100%;
        min-height: 47px;
        background: #091f2c;
        color: #f2f9fb;
        border: 1px solid #355361;
        border-radius: 8px;
        padding: 11px 55px 11px 13px;
        font-size: 14px;
    }

        .eh-password-input:focus {
            outline: none;
            border-color: #22c9bb;
            box-shadow: 0 0 0 3px rgba(20,184,172,.12);
        }

        .eh-password-input::placeholder {
            color: #7897a5;
        }

    .eh-password-toggle {
        position: absolute;
        right: 5px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #75c9c4;
        cursor: pointer;
        padding: 9px;
        font-size: 12px;
        font-weight: 700;
        min-width: 47px;
    }

        .eh-password-toggle:hover {
            color: #69eee0;
        }

    .eh-password-hint {
        display: block;
        color: #9cb9c5;
        font-size: 12px;
        margin-top: 8px;
        line-height: 1.6;
    }

    .eh-password-rules {
        padding: 18px;
        background: #0b2532;
        border: 1px solid #2b4c59;
        border-radius: 10px;
        margin-bottom: 25px;
    }

        .eh-password-rules h3 {
            color: #dcecf0;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 12px;
        }

    .eh-rule {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #adc5cf;
        font-size: 12px;
        margin: 8px 0;
    }

    .eh-rule-indicator {
        width: 9px;
        height: 9px;
        background: #64808d;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .eh-rule.valid {
        color: #62e4d1;
    }

        .eh-rule.valid .eh-rule-indicator {
            background: #29c9b6;
        }

    .eh-rule.invalid {
        color: #ffaaaa;
    }

        .eh-rule.invalid .eh-rule-indicator {
            background: #e77474;
        }

    .eh-password-error {
        color: #ffaaaa;
        font-size: 12px;
        min-height: 17px;
        margin-top: 6px;
    }

    .eh-validation-summary {
        color: #ffc0c0;
        background: #39262d;
        border: 1px solid #75414b;
        border-radius: 9px;
        padding: 14px;
        margin-bottom: 22px;
        font-size: 13px;
    }

        .eh-validation-summary.validation-summary-valid {
            display: none;
        }

        .eh-validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .eh-success {
        background: #103d3c;
        color: #83edda;
        border: 1px solid #2c8179;
        border-radius: 9px;
        padding: 13px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .eh-password-submit {
        width: 100%;
        min-height: 47px;
        background: #34d1c4;
        color: #062a2c;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 750;
        cursor: pointer;
    }

        .eh-password-submit:hover {
            background: #5ae3d7;
        }

        .eh-password-submit:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .eh-security-note {
        text-align: center;
        color: #97b5c1;
        font-size: 12px;
        margin-top: 18px;
        line-height: 1.6;
    }

    @@media (max-width: 650px) {
        .eh-password-page {
            padding: 5px 0 30px;
        }

        .eh-password-content {
            padding: 21px 17px;
        }

        .eh-password-heading h1 {
            font-size: 24px;
        }
    }
</style>

<div class="eh-password-page">

    <!-- PAGE HEADING -->

    <div class="eh-password-heading">
        <h1>Change Password</h1>

        <p>
            Update your EntryHub password to keep
            your account secure.
        </p>
    </div>

    <div class="eh-password-card">

        <div class="eh-password-content">

            <!-- SUCCESS MESSAGE -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="eh-success" role="status">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- SERVER VALIDATION MESSAGES -->

            <div asp-validation-summary="All"
                 class="eh-validation-summary"
                 role="alert">
            </div>

            <!-- PASSWORD CHANGE FORM -->

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post"
                  id="changePasswordForm">

                @Html.AntiForgeryToken()

                <!-- CURRENT PASSWORD -->

                <div class="eh-password-field">

                    <label for="currentPassword"
                           class="eh-password-label">
                        Current Password
                    </label>

                    <div class="eh-password-input-group">

                        <input type="password"
                               id="currentPassword"
                               name="currentPassword"
                               class="eh-password-input"
                               placeholder="Enter current password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="eh-password-toggle"
                                data-target="currentPassword"
                                aria-label="Show current password"
                                aria-pressed="false">
                            Show
                        </button>

                    </div>

                </div>

                <!-- NEW PASSWORD -->

                <div class="eh-password-field">

                    <label for="newPassword"
                           class="eh-password-label">
                        New Password
                    </label>

                    <div class="eh-password-input-group">

                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               class="eh-password-input"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               minlength="12"
                               maxlength="128"
                               required />

                        <button type="button"
                                class="eh-password-toggle"
                                data-target="newPassword"
                                aria-label="Show new password"
                                aria-pressed="false">
                            Show
                        </button>

                    </div>

                </div>

                <!-- CONFIRM NEW PASSWORD -->

                <div class="eh-password-field">

                    <label for="confirmPassword"
                           class="eh-password-label">
                        Confirm New Password
                    </label>

                    <div class="eh-password-input-group">

                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               class="eh-password-input"
                               placeholder="Re-enter new password"
                               autocomplete="new-password"
                               minlength="12"
                               maxlength="128"
                               required />

                        <button type="button"
                                class="eh-password-toggle"
                                data-target="confirmPassword"
                                aria-label="Show confirmed password"
                                aria-pressed="false">
                            Show
                        </button>

                    </div>

                    <div id="passwordMatchError"
                         class="eh-password-error"
                         aria-live="polite">
                    </div>

                </div>

                <!-- PASSWORD GUIDELINES -->

                <div class="eh-password-rules">

                    <h3>Password Requirements</h3>

                    <div class="eh-rule"
                         id="ruleLength">

                        <span class="eh-rule-indicator"></span>
                        Between 12 and 128 characters

                    </div>

                    <div class="eh-rule"
                         id="ruleMatch">

                        <span class="eh-rule-indicator"></span>
                        Both new passwords match

                    </div>

                    <div class="eh-rule">

                        <span class="eh-rule-indicator"></span>
                        Use a unique password or long passphrase

                    </div>

                    <div class="eh-rule">

                        <span class="eh-rule-indicator"></span>
                        Avoid common or previously used passwords

                    </div>

                </div>

                <!-- SUBMIT -->

                <button type="submit"
                        id="updatePasswordBtn"
                        class="eh-password-submit">

                    Update Password

                </button>

                <p class="eh-security-note">
                    Your current password is required to
                    authorise this change.
                </p>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById(
                "changePasswordForm"
            );

            const current = document.getElementById(
                "currentPassword"
            );

            const next = document.getElementById(
                "newPassword"
            );

            const confirm = document.getElementById(
                "confirmPassword"
            );

            const matchError = document.getElementById(
                "passwordMatchError"
            );

            const lengthRule = document.getElementById(
                "ruleLength"
            );

            const matchRule = document.getElementById(
                "ruleMatch"
            );

            const submit = document.getElementById(
                "updatePasswordBtn"
            );

            function updateRules() {
                const lengthValid =
                    next.value.length >= 12 &&
                    next.value.length <= 128;

                const passwordsMatch =
                    confirm.value.length > 0 &&
                    next.value === confirm.value;

                lengthRule.classList.toggle(
                    "valid",
                    lengthValid
                );

                matchRule.classList.toggle(
                    "valid",
                    passwordsMatch
                );

                const mismatch =
                    confirm.value.length > 0 &&
                    next.value !== confirm.value;

                matchRule.classList.toggle(
                    "invalid",
                    mismatch
                );

                matchError.textContent = mismatch
                    ? "Passwords do not match."
                    : "";

                confirm.setCustomValidity(
                    mismatch
                        ? "Passwords do not match."
                        : ""
                );

                return lengthValid && passwordsMatch;
            }

            next.addEventListener(
                "input",
                updateRules
            );

            confirm.addEventListener(
                "input",
                updateRules
            );

            document.querySelectorAll(
                ".eh-password-toggle"
            ).forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        const target =
                            document.getElementById(
                                button.dataset.target
                            );

                        const visible =
                            target.type === "password";

                        target.type = visible
                            ? "text"
                            : "password";

                        button.textContent = visible
                            ? "Hide"
                            : "Show";

                        button.setAttribute(
                            "aria-pressed",
                            String(visible)
                        );

                        button.setAttribute(
                            "aria-label",
                            (visible ? "Hide " : "Show ") +
                            target.id
                        );
                    }
                );
            });

            form.addEventListener(
                "submit",
                event => {

                    if (!updateRules()) {
                        event.preventDefault();

                        if (
                            next.value.length < 12 ||
                            next.value.length > 128
                        ) {
                            next.focus();
                        } else {
                            confirm.focus();
                        }

                        return;
                    }

                    submit.disabled = true;
                    submit.textContent = "Updating...";
                }
            );
        })();
    </script>
}
