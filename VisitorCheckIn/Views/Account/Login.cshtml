@model LoginVm
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign in"; }
<div class="auth-wrap">
  <div class="auth-brand"><partial name="_BrandMark" />EntryHub</div>
  <div class="auth-card">
    <h1>Sign in</h1>
    <p class="sub">Use your admin or host account.</p>
    <form method="post">
      <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
      <div asp-validation-summary="All" class="text-danger"></div>
      <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" autofocus /></div>
      <div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
      <div class="form-check mb-4"><input asp-for="Remember" class="form-check-input" /><label asp-for="Remember" class="form-check-label">Keep me signed in</label></div>
      <button class="btn btn-primary btn-lg w-100">Sign in</button>
    </form>
  </div>
  <div class="auth-foot"><a href="/" style="color:#9fb6c0">&larr; Back to start</a></div>
</div>
