<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the app also run if only a newer .NET runtime (9 / 10) is installed -->
    <RollForward>Major</RollForward>
    <RootNamespace>VisitorCheckIn</RootNamespace>
    <AssemblyName>VisitorCheckIn</AssemblyName>
    <UserSecretsId>17eda865-bdba-4ed4-ba57-a3545cc515ea</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10" />
    <PackageReference Include="WebPush" Version="1.0.12" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
